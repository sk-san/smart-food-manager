# Copy to .env and adjust. Used by docker-compose and the Go backend.

# --- Postgres (compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=foodapp

# --- Backend ---
PORT=8080
DATABASE_URL=postgres://app:app@localhost:5432/foodapp?sslmode=disable
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY_MINUTES=60
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
ALLOWED_ORIGIN=http://localhost:5173

# --- Frontend (Vite) ---
# Leave empty in dev so requests are proxied; set to the API URL in prod.
VITE_API_BASE_URL=
