{
  "uid": "foodapp-dependencies-ai",
  "title": "Smart Food Manager — Dependencies & AI",
  "description": "External API calls (Gemini etc.), LLM token usage, and file uploads (foodapp_external_api_*, foodapp_llm_*, foodapp_file_upload_* metrics).",
  "tags": ["foodapp", "dependencies", "llm"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "External call rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(foodapp_external_api_requests_total[$__rate_interval]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "External failure rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(foodapp_external_api_requests_total{event_outcome=\"failure\"}[$__rate_interval])) or vector(0)) / sum(rate(foodapp_external_api_requests_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 external call duration",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2500 },
              { "color": "red", "value": 8000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(foodapp_external_api_duration_ms_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LLM tokens / min (in + out)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * (sum(rate(foodapp_llm_input_tokens_total[$__rate_interval])) or vector(0)) + 60 * (sum(rate(foodapp_llm_output_tokens_total[$__rate_interval])) or vector(0))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "External call rate by provider / service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency_provider, dependency_service, dependency_operation) (rate(foodapp_external_api_requests_total[$__rate_interval]))",
          "legendFormat": "{{dependency_provider}}/{{dependency_service}} {{dependency_operation}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "External failures by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "showPoints": "never", "lineWidth": 1 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency_service, dependency_operation) (rate(foodapp_external_api_requests_total{event_outcome=\"failure\"}[$__rate_interval]))",
          "legendFormat": "{{dependency_service}} {{dependency_operation}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 external call duration by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 5, "showPoints": "never", "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, dependency_service) (rate(foodapp_external_api_duration_ms_bucket[$__rate_interval])))",
          "legendFormat": "{{dependency_service}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM token throughput",
      "description": "Populates once handlers record foodapp_llm_*_tokens_total (defined in internal/telemetry/metrics.go).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 15, "showPoints": "never", "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(foodapp_llm_input_tokens_total[$__rate_interval]))",
          "legendFormat": "input tokens/min"
        },
        {
          "refId": "B",
          "expr": "60 * sum(rate(foodapp_llm_output_tokens_total[$__rate_interval]))",
          "legendFormat": "output tokens/min"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "File uploads per minute by outcome",
      "description": "Populates once handlers record foodapp_file_uploads_total (defined in internal/telemetry/metrics.go).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 30, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (event_outcome) (rate(foodapp_file_uploads_total[$__rate_interval]))",
          "legendFormat": "{{event_outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Recent dependency failures",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 22 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{event_category=\"dependency\", event_outcome=\"failure\"} | json"
        }
      ]
    }
  ]
}
